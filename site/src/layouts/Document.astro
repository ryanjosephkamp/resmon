---
/**
 * A rendered Markdown document: the reference pages, the guide pages split out
 * of the README, and the update posts all use this.
 *
 * The contents list is built from the generated heading ids rather than from a
 * hand-written list, so it cannot fall out of step with the document. It only
 * appears when there is enough document to be worth navigating — four or more
 * top-level sections — and it is plain links, so it works with JavaScript off
 * and reads as an ordinary list on a phone.
 */
import Base from './Base.astro';
import type { Heading } from '../lib/markdown';

interface Props {
  title: string;
  description: string;
  path: string;
  /**
   * The section this page belongs to. Set in the line under the title, as a
   * listing entry carries its section, not as a label above the heading.
   */
  eyebrow?: string;
  /** Rendered beneath the title: a date, a summary, a source path. */
  meta?: string;
  html: string;
  headings: Heading[];
  width?: 'prose' | 'wide';
}

const {
  title,
  description,
  path,
  eyebrow,
  meta,
  html,
  headings,
  width = 'prose',
} = Astro.props;

const sections = headings.filter((heading) => heading.depth === 2);
const showContents = sections.length >= 4;
---

<Base title={title} description={description} path={path} width={width}>
  <article>
    <header class="doc-head">
      <h1>{title}</h1>
      {(eyebrow || meta) && (
        <p class="meta">
          {eyebrow && <span class="section">{eyebrow}</span>}
          {meta && <span>{meta}</span>}
        </p>
      )}
    </header>

    {
      showContents && (
        <nav class="contents" aria-labelledby="contents-heading">
          <h2 id="contents-heading" class="contents-heading">
            On this page
          </h2>
          <ul>
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`} set:html={section.text} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose" set:html={html} />
  </article>

  {/* Anything a page wants beneath the document: a pager, a related list. */}
  <slot />
</Base>

<style>
  .doc-head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width-heavy) solid var(--color-rule-heavy);
  }

  .doc-head h1 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .section {
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .section::after {
    content: '\00B7';
    margin-inline-start: var(--space-3);
    color: var(--color-text-faint);
  }

  .contents {
    margin-bottom: var(--space-6);
    padding-block: var(--space-3);
    border-block: var(--border-width) solid var(--color-border);
  }

  .contents-heading {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .contents ul {
    margin: 0;
    padding-inline-start: var(--space-5);
    font-size: var(--text-sm);
    columns: 2 16rem;
    column-gap: var(--space-6);
  }

  .contents li + li {
    margin-top: var(--space-1);
  }
</style>
