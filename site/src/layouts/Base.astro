---
/**
 * The page shell: head, masthead, navigation, footer.
 *
 * Ships no client JavaScript. There is no script tag on any content page and
 * no theme toggle writing to localStorage; the color scheme follows
 * `prefers-color-scheme`. The two typefaces are files on this site, bundled
 * from `@fontsource`, so a page here makes no request to anywhere but GitHub.
 */
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/400-italic.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '@fontsource/atkinson-hyperlegible-next/800.css';
import '@fontsource/atkinson-hyperlegible-mono/400.css';
import '@fontsource/atkinson-hyperlegible-mono/600.css';
import textFont from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import displayFont from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-800-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import Mark from '../components/Mark.astro';
import { url, absoluteUrl, GITHUB_REPO } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  /** Path on this site, without the base, for the canonical link. */
  path: string;
  /**
   * `prose` keeps a reading measure, `wide` relaxes it for listings and
   * reference tables, and `full` hands the whole shell to the page, which lays
   * out its own grid (the home page).
   */
  width?: 'prose' | 'wide' | 'full';
}

const { title, description, path, width = 'prose' } = Astro.props;

const SITE_NAME = 'resmon';
const fullTitle = title === SITE_NAME ? `${SITE_NAME} · Research Monitor` : `${title} · ${SITE_NAME}`;

const nav = [
  { label: 'Sources', href: '/#sources' },
  { label: 'Tour', href: '/#tour' },
  { label: 'Guide', href: '/guide/' },
  { label: 'Updates', href: '/updates/' },
  // On a phone these two live in the footer only, so the masthead stays one row.
  { label: 'Reference', href: '/reference/', wide: true },
];

const current = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && current.startsWith(url(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(path)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(path)} />
    <meta property="og:image" content={absoluteUrl('/media/resmon-og.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    {/*
      The in-app Blog tab hard-codes the feed URL, so this element is for feed
      readers and browsers, not for the app. It is still declared at the path
      the app uses, so the two can never point at different files.
    */}
    <link
      rel="alternate"
      type="application/atom+xml"
      title="resmon updates"
      href={url('/feed.xml')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead-inner">
        <a class="wordmark" href={url('/')}>
          <Mark />
          <span>resmon</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav">
            {
              nav.map((item) => (
                <li class:list={[item.wide && 'nav-wide']}>
                  <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="nav-wide">
              <a href={GITHUB_REPO} rel="noopener">Source code</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main
      id="main"
      class:list={['shell', 'main', width === 'wide' && 'main-wide', width === 'full' && 'main-full']}
    >
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer-inner">
        <p class="footer-line">
          <Mark />
          <span>
            resmon is free and open source under the MIT license, by Ryan Kamp. Everything it
            retrieves stays on the computer that retrieved it.
          </span>
        </p>
        <ul class="footer-links">
          <li><a href={GITHUB_REPO}>Source code</a></li>
          <li><a href={`${GITHUB_REPO}/releases`}>Releases</a></li>
          <li><a href={url('/guide/')}>Guide</a></li>
          <li><a href={url('/reference/')}>Reference</a></li>
          <li><a href={url('/guide/license/')}>License</a></li>
          <li><a href={url('/third-party-notices/')}>Third-party notices</a></li>
          <li><a href={url('/feed.xml')}>Atom feed</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .shell {
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .masthead {
    background: var(--color-mast);
    color: var(--color-mast-text);
  }

  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    min-height: var(--masthead-height);
    padding-block: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-heavy);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--color-mast-text);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-mast-text);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .nav li + li {
    margin-top: 0;
  }

  .nav-wide {
    display: none;
  }

  .nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-mast-muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--color-mast-text);
  }

  .nav a[aria-current='page'] {
    color: var(--color-mast-text);
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width-heavy);
    text-underline-offset: var(--underline-offset);
    text-decoration-color: var(--color-mast-text);
  }

  /*
   * Every page shares the masthead's left edge. A narrow page keeps its reading
   * measure by limiting its content, not by centering a narrow column under a
   * wide masthead, which set the text 240 px in from everything around it.
   */
  .main {
    display: block;
    padding-block: var(--space-6) var(--space-8);
  }

  .main > :global(*) {
    max-width: var(--measure-wide);
  }

  .main-full {
    padding-block: 0 var(--space-8);
  }

  .main-full > :global(*) {
    max-width: none;
  }

  .footer {
    border-top: var(--border-width-heavy) solid var(--color-rule-heavy);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding-block: var(--space-5) var(--space-6);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-3);
  }

  .footer-line {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: var(--measure);
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links li + li {
    margin-top: 0;
  }

  @media (min-width: 40rem) {
    .shell {
      padding-inline: var(--gutter-wide);
    }

    .nav-wide {
      display: list-item;
    }
  }
</style>
