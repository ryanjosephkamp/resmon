---
/**
 * The home page, at `/resmon/`.
 *
 * It opens on the app's own morning view, Today, drawn by the site from a
 * real collection (`../components/TodayPlate.astro`): the plate of everything
 * collected with the new papers ringed and numbered, and the index beside it.
 * Under it, every source with the facts the app shows before a search
 * (`src/data/sources.json`, kept current by a backend test), the Source wall
 * from the same collection, what each part of the app does, what stays on
 * your computer, and how to get it.
 */
import Base from '../layouts/Base.astro';
import TodayPlate from '../components/TodayPlate.astro';
import RunRecord from '../components/RunRecord.astro';
// Written beside the tour by `resmon_scripts/frontend/demos/media.ts`: where each segment starts.
import tour from '../../public/media/resmon-tour.json';
import { url, GITHUB_REPO, GITHUB_RELEASES } from '../lib/urls';
import {
  SOURCES,
  SOURCE_COUNT,
  keyShort,
  keyLong,
  datesShort,
  dateLong,
  authorLong,
  rateShort,
  creditLabel,
} from '../lib/sources';

const NAMED = ['arXiv', 'PubMed', 'OpenAlex', 'CrossRef'].filter((name) => SOURCES.some((s) => s.name === name));
const named = `${NAMED.join(', ')}, and ${SOURCE_COUNT - NAMED.length} more`;

const description =
  `resmon is a free desktop app that watches ${SOURCE_COUNT} open scholarly sources for the ` +
  'papers you follow, keeps what it finds on your own computer, and records what every source did ' +
  'on every run.';

const parts = [
  {
    name: 'Today',
    line: 'What is new since you last looked, on a map of everything you have collected.',
    detail:
      'Papers sit by the wording they share, brighter the newer they are. The new ones are ringed and numbered, and each number is one entry in the list beside the map.',
  },
  {
    name: 'Watches',
    line: 'A search resmon runs on a schedule and keeps the papers of.',
    detail:
      'A watch can follow words, a person’s new papers, or retractions and corrections on a person’s papers. The Calendar shows when each is due, and says so when nothing will run it.',
  },
  {
    name: 'Search',
    line: 'Ask the sources, or search what you already hold.',
    detail:
      'A Deep Dive asks one source in depth and a Deep Sweep asks several at once. Before you ask, resmon lists each source’s limits: how it combines your terms, how finely it dates a paper, and whether it needs a key.',
  },
  {
    name: 'Library',
    line: 'A reading queue, your own files, and the passages you keep.',
    detail:
      'Keep PDF, TXT, and MD files as unchanging copies in a folder you choose, read them in the app, and pin exact passages in Evidence projects. The Library is not yet available on Windows.',
  },
  {
    name: 'Ask',
    line: 'An assistant that reads your watches, runs, and papers.',
    detail:
      'Through Claude Code or Codex under your own sign-in, or your own provider key. It uses the same tools an outside program can, and nothing is billed through resmon.',
  },
  {
    name: 'Health',
    line: 'Whether the watching itself is intact.',
    detail:
      'The Source wall marks what every source did on each recent run. The Watchdog says what resmon can tell is wrong with its watching, and a check finds retractions and newer versions of papers you hold.',
  },
  {
    name: 'Outside the window',
    line: 'A command line, an MCP server, and a local HTTP API.',
    detail:
      'The resmon command ships inside the app and installs from its menu. Tools that speak the Model Context Protocol can run watches and searches and read the collection.',
  },
  {
    name: 'Delivery and backup',
    line: 'Reports where you read them.',
    detail:
      'Every run writes a report. A watch can email it, post it to a signed webhook, or put it in a folder or a feed on your own disk. Back up the database to a folder you keep.',
  },
];

/** "0:42", for a chapter's start. */
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const tourVideo = url('/media/resmon-tour.mp4');

const platforms = [
  { name: 'macOS, Apple Silicon', file: 'DMG', status: 'Used daily.' },
  { name: 'macOS, Intel', file: 'DMG', status: 'Built and opened by the release check on every release; not used daily.' },
  { name: 'Windows (x64)', file: 'Installer (.exe)', status: 'Built and opened by the release check; not used daily. The Library is not yet available.' },
  { name: 'Linux (x64)', file: 'AppImage', status: 'Built and opened by the release check; not used daily.' },
];
---

<Base title="resmon" description={description} path="/" width="full">
  <header class="lead">
    <h1><span>Research moves fast.</span> <span>resmon does, too.</span></h1>
    <div class="lead-side">
      <p>
        resmon is a free desktop app. It asks {named} on a schedule or when you ask, keeps every paper it finds
        on your computer, and records what each source did on every run. This is its morning view, drawn from a
        real collection.
      </p>
      <p class="lead-action">
        <a class="action" href={GITHUB_RELEASES}>Download resmon</a>
        <a href={url('/guide/install/')}>Install guide</a>
        <span class="lead-small">Version 1.0.0 for macOS, Windows, and Linux. Free, under the MIT license.</span>
      </p>
    </div>
  </header>

  <TodayPlate />

  <section id="sources" class="band" aria-labelledby="sources-title">
    <header class="band-head">
      <h2 id="sources-title">The sources</h2>
      <p class="band-count">{SOURCES.length} sources</p>
    </header>
    <p class="band-lede">
      Every source resmon asks, with what the app tells you before a search: whether it needs your key, the rate
      resmon holds itself to, how it combines your terms, and the finest window of dates it can answer. Open a source
      for the rest.
    </p>

    <ul class="catalog">
      {
        SOURCES.map((source) => (
          <li id={`source-${source.slug}`}>
            <details>
              <summary>
                <span class="source-name">
                  {source.name}
                  <svg class="chevron" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m4.5 6.25 3.5 3.5 3.5-3.5" />
                  </svg>
                </span>
                <span class="source-cover">{source.subject_coverage}</span>
                <span class="source-facts">
                  <span>{keyShort(source)}</span>
                  <span>{rateShort(source)}</span>
                  <span>{source.keyword_combination}</span>
                  <span>{datesShort(source)}</span>
                </span>
              </summary>
              <dl class="source-more">
                <dt>What it is</dt>
                <dd>{source.description}.</dd>
                <dt>API key</dt>
                <dd>{keyLong(source)}</dd>
                <dt>Rate</dt>
                <dd>{source.rate_limit}</dd>
                <dt>Terms</dt>
                <dd>{source.keyword_combination}</dd>
                <dt>Dates</dt>
                <dd>{dateLong(source)}</dd>
                <dt>Authors</dt>
                <dd>{authorLong(source)}</dd>
                {creditLabel(source) && (
                  <>
                    <dt>Credit</dt>
                    <dd>
                      {source.attribution} <span class="credit-kind">{creditLabel(source)}</span>
                    </dd>
                  </>
                )}
                <dt>Website</dt>
                <dd>
                  <a href={source.website} rel="noopener">{source.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
                </dd>
              </dl>
            </details>
          </li>
        ))
      }
    </ul>
    <p class="band-note">
      The facts come from the catalog in resmon’s source code. What each source’s terms let resmon keep, and why some
      sources are not here, is in <a href={url('/guide/sources/')}>Sources and their terms</a>.
    </p>
  </section>

  <section id="record" class="band" aria-labelledby="record-title">
    <header class="band-head">
      <h2 id="record-title">What every source did</h2>
    </header>
    <p class="band-lede">
      A quiet morning and a broken search must never look the same. resmon records what every source did on every
      run, and says why a source returned nothing: it answered and had nothing, it could not be asked, or it never
      answered. This is the Source wall of the collection above, starting with its verdict, word for word.
    </p>
    <RunRecord />
  </section>

  <section id="tour" class="band" aria-labelledby="tour-title">
    <header class="band-head">
      <h2 id="tour-title">The tour</h2>
      <p class="band-count">{Math.round(tour.seconds)} seconds</p>
    </header>
    <div class="tour" data-tour>
      <video class="tour-video" controls muted playsinline preload="metadata"
        poster={url('/media/resmon-tour-poster.webp')} width="1920" height="1080">
        <source src={tourVideo} type="video/mp4" />
        <a href={tourVideo}>Download the tour (MP4)</a>
      </video>
      <ol class="chapters">
        {
          tour.chapters.map((chapter) => (
            <li>
              <a class="chapter-at" href={`${tourVideo}#t=${chapter.start}`} data-at={chapter.start}>
                {clock(chapter.start)}
              </a>
              <span><strong>{chapter.title}</strong> {chapter.line}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="band-note">
      Recorded on November 3, 2026, in a copy of the collection drawn above. The searches in it asked the public
      sources for real; the clicks are scripted, at a person's pace.
    </p>
  </section>

  <section id="what" class="band" aria-labelledby="what-title">
    <header class="band-head">
      <h2 id="what-title">What it does</h2>
    </header>
    <dl class="parts">
      {
        parts.map((part) => (
          <div>
            <dt>{part.name}</dt>
            <dd>
              <span class="part-line">{part.line}</span> {part.detail}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="band-note">
      Settings › Tutorials walks through each screen in the app, and the <a href={url('/guide/')}>guide</a> goes
      further.
    </p>
  </section>

  <section id="local" class="band" aria-labelledby="local-title">
    <header class="band-head">
      <h2 id="local-title">On your computer</h2>
    </header>
    <dl class="facts">
      <div>
        <dt>No account</dt>
        <dd>There is nothing to sign up for, and no resmon server to sign in to.</dd>
      </div>
      <div>
        <dt>Your collection</dt>
        <dd>A database and a folder of reports on your own disk, with your watches, runs, and reading.</dd>
      </div>
      <div>
        <dt>Your keys</dt>
        <dd>Kept in your operating system’s keychain, never in the database, and sent only to the service they belong to.</dd>
      </div>
      <div>
        <dt>No telemetry</dt>
        <dd>
          resmon sends no usage data. A search sends its terms only to the sources it asks; summaries, delivery, and
          backup send only what you switch on, to where you point them.
        </dd>
      </div>
    </dl>
  </section>

  <section id="install" class="band" aria-labelledby="install-title">
    <header class="band-head">
      <h2 id="install-title">Get it</h2>
      <p class="band-count">Version 1.0.0 · MIT license</p>
    </header>
    <div class="install">
      <table class="platforms">
        <thead>
          <tr>
            <th scope="col">Platform</th>
            <th scope="col">File</th>
            <th scope="col">Tested</th>
          </tr>
        </thead>
        <tbody>
          {
            platforms.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                <td>{p.file}</td>
                <td>{p.status}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="install-side">
        <p><a class="action" href={GITHUB_RELEASES}>Download resmon</a></p>
        <p>
          The macOS builds are not signed, so the first launch needs one extra step. Windows and Linux builds update
          themselves. The <a href={url('/guide/install/')}>install guide</a> covers both, and running from
          <a href={GITHUB_REPO}>the source</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // A chapter's time plays the tour from there, in place. Without scripts it opens the video at that moment.
  for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const video = tour.querySelector('video');
    for (const link of tour.querySelectorAll<HTMLAnchorElement>('[data-at]')) {
      link.addEventListener('click', (event) => {
        if (!video) return;
        event.preventDefault();
        video.currentTime = Number(link.dataset.at);
        void video.play();
        video.focus();
      });
    }
  }
</script>

<style>
  /* ---- The title ---------------------------------------------------------- */

  .lead {
    display: grid;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-6) var(--space-5);
  }

  .lead h1 {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  /* One sentence to a line. */
  .lead h1 span {
    display: block;
  }

  /* On a phone, a size down, so the first sentence holds its line. */
  @media (max-width: 39.99rem) {
    .lead h1 {
      font-size: var(--text-2xl);
    }
  }

  .lead-side p {
    margin: 0;
    max-width: var(--measure);
  }

  .lead-side p + p {
    margin-top: var(--space-4);
  }

  .lead-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .lead-small {
    flex-basis: 100%;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ---- Sections ----------------------------------------------------------- */

  .band {
    padding-block: var(--space-8) 0;
  }

  .band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .band-head h2 {
    margin: 0;
    padding-bottom: var(--space-3);
    border: 0;
    font-size: var(--text-2xl);
  }

  .band-count {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .band-lede {
    max-width: var(--measure);
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted);
  }

  .band-note {
    max-width: var(--measure);
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ---- The catalog ---------------------------------------------------------- */

  .catalog {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .catalog li {
    margin: 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .catalog summary {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
  }

  .catalog summary::-webkit-details-marker {
    display: none;
  }

  .source-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .chevron {
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-text-faint);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--duration-fast) var(--ease);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .catalog summary:hover .chevron {
    stroke: var(--color-text);
  }

  .source-cover {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .source-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .source-facts span + span::before {
    content: '';
    display: inline-block;
    width: var(--space-1);
    height: var(--space-1);
    margin-inline-end: var(--space-3);
    border-radius: 50%;
    background: var(--color-border-strong);
    vertical-align: middle;
  }

  .source-more {
    display: grid;
    grid-template-columns: var(--entry-label) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    max-width: var(--measure-wide);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) 0 0;
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .source-more dt {
    font-weight: var(--weight-semibold);
  }

  .source-more dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .credit-kind {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ---- What it does --------------------------------------------------------- */

  .parts {
    display: grid;
    margin: 0;
  }

  .parts div {
    display: grid;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-4);
  }

  .parts div + div {
    border-top: var(--border-width) solid var(--color-border);
  }

  .parts dt {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .parts dd {
    margin: 0;
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .part-line {
    color: var(--color-text);
  }

  /* ---- On your computer ----------------------------------------------------- */

  .facts {
    display: grid;
    gap: var(--space-5) var(--space-6);
    margin: 0;
  }

  .facts dt {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .facts dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* ---- Get it --------------------------------------------------------------- */

  .install {
    display: grid;
    gap: var(--space-5) var(--space-7);
  }

  .platforms {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .platforms th,
  .platforms td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    text-align: start;
    vertical-align: top;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .platforms thead th {
    padding-top: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    border-bottom-color: var(--color-border-strong);
  }

  .platforms tbody th {
    font-weight: var(--weight-semibold);
  }

  .platforms td {
    color: var(--color-text-muted);
  }

  .install-side p {
    margin: 0 0 var(--space-4);
    max-width: var(--measure);
  }

  /* ---- Wider ------------------------------------------------------------------ */

  @media (min-width: 48rem) {
    .catalog summary {
      grid-template-columns: var(--date-column) minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    .source-facts {
      grid-column: 2;
    }

    .source-more {
      margin-inline-start: calc(var(--date-column) + var(--space-5));
    }

    .parts div {
      grid-template-columns: var(--date-column) minmax(0, 1fr);
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      padding-block: var(--space-6) var(--space-5);
    }

    .catalog summary {
      grid-template-columns: var(--date-column) minmax(0, 1fr) minmax(0, 1.1fr);
    }

    .source-facts {
      grid-column: 3;
      display: grid;
      grid-template-columns: var(--fact-key) var(--fact-rate) minmax(0, 1fr) var(--fact-dates);
      gap: var(--space-1) var(--space-4);
      align-items: baseline;
    }

    .source-facts span + span::before {
      display: none;
    }

    .facts {
      grid-template-columns: repeat(4, 1fr);
    }

    .install {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ---- The tour ---------------------------------------------------------- */

  .tour {
    display: grid;
    gap: var(--space-5);
  }

  .tour-video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-canvas);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 var(--space-6);
    font-size: var(--text-sm);
  }

  .chapters li {
    display: grid;
    grid-template-columns: var(--space-7) minmax(0, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
  }

  .chapters strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .chapter-at {
    color: var(--color-accent-text);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 52rem) {
    .chapters {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
