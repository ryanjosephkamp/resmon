---
/**
 * The reference index: the documents in `docs/` and the generated API contract
 * in `docs/api-contract/`.
 *
 * Both sets are rendered from the Markdown where it already lives in the
 * repository, so a reader of the site and a reader of a checkout see the same
 * text. The contract half in particular is generated by
 * `implementation_scripts/api_contract.py` and guarded by a test; nothing here
 * edits it, and the page says so.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readDocument } from '../../lib/documents';
import Cartouche from '../../components/Cartouche.astro';
import IndexList from '../../components/IndexList.astro';
import { url } from '../../lib/urls';

const docs = (await getCollection('docs')).sort((a, b) => a.id.localeCompare(b.id));
const contract = (await getCollection('apiContract')).sort((a, b) => a.id.localeCompare(b.id));

const describe = (id: string, body: string | undefined) => readDocument(body ?? '', id);

const docRows = docs.map((entry) => ({
  href: url(`/${entry.id}/`),
  source: `docs/${entry.id}.md`,
  ...describe(entry.id, entry.body),
}));

const contractRows = contract.map((entry) => ({
  href: url(entry.id === 'README' ? '/api-contract/' : `/api-contract/${entry.id}/`),
  source: `docs/api-contract/${entry.id}.md`,
  ...describe(entry.id, entry.body),
}));
---

<Base
  title="Reference"
  description="The reference documents that ship with the resmon repository, and the generated HTTP and MCP contract."
  path="/reference/"
  width="wide"
>
  <Cartouche
    title="Reference"
    meta="Rendered from the Markdown in the repository's docs/ folder, not copied from it, so the site and a checkout cannot disagree."
  />

  <h2>Documents</h2>
  <IndexList rows={docRows.map((row) => ({ href: row.href, title: row.title, description: row.description, source: row.source }))} />

  <h2>The API contract</h2>
  <p class="lede">
    Generated from the running application by <code>implementation_scripts/api_contract.py</code>
    and guarded by <code>verification_scripts/test_api_contract.py</code>, which regenerates both
    files and fails on any difference. Published here, never edited here.
  </p>
  <IndexList
    rows={[
      ...contractRows.map((row) => ({ href: row.href, title: row.title, description: row.description, source: row.source })),
      {
        href: url('/api-contract/openapi.json'),
        title: 'openapi.json',
        description: 'The OpenAPI document for every route, served as the file the generator writes.',
        source: 'docs/api-contract/openapi.json',
      },
    ]}
  />
</Base>

<style>
  h2 {
    font-size: var(--text-xl);
  }

  .lede {
    color: var(--color-text-muted);
    max-width: var(--measure);
    margin: 0;
  }
</style>
