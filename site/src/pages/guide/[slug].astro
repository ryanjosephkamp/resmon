---
/**
 * One guide page per section split out of the README.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const guide = await getCollection('guide');
  return guide.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props as Props;
/*
 * The guide bodies are the README's own text with its own heading levels, which
 * is what makes `split-readme.mjs`'s reassembly check meaningful. One
 * consequence is corrected at render time rather than in the file: each chunk
 * opens with the README section heading it was cut from ("Quick Start Guide",
 * or `# resmon — Research Monitor` for the overview), directly under a page
 * title that already names it. A heading on the body's first line is left out
 * of the page; the Markdown on disk is untouched.
 */
const body = (entry.body ?? '').replace(/^\s*#{1,3} [^\n]*\n/, '');
const { html, headings } = await renderMarkdown(body, { from: '.', fromReadme: true });
---

<Document
  title={entry.data.title}
  description={entry.data.summary}
  path={`/guide/${entry.id}/`}
  eyebrow="Guide"
  meta={entry.data.summary}
  html={html}
  headings={headings}
/>
