---
/**
 * One guide page per section split out of the README.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const guide = await getCollection('guide');
  return guide.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props as Props;
const { html, headings } = await renderMarkdown(entry.body ?? '', { fromReadme: true });
---

<Document
  title={entry.data.title}
  description={entry.data.summary}
  path={`/guide/${entry.id}/`}
  eyebrow="Guide"
  meta={entry.data.summary}
  html={html}
  headings={headings}
/>
