---
/**
 * One guide page for each file in `site/src/content/guide/`.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';
import { renderMarkdown } from '../../lib/markdown';
import { guideRail } from '../../lib/rails';

export async function getStaticPaths() {
  const guide = await getCollection('guide');
  return guide.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props as Props;
const body = entry.body ?? '';
const rail = await guideRail();
const { html, headings } = await renderMarkdown(body, { from: '.' });
---

<Document
  title={entry.data.title}
  description={entry.data.summary}
  path={`/guide/${entry.id}/`}
  section="Guide"
  rail={rail}
  meta={entry.data.summary}
  html={html}
  headings={headings}
/>
