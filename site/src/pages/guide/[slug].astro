---
/**
 * One guide page per section split out of the README.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const guide = await getCollection('guide');
  return guide.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props as Props;
/*
 * The guide bodies are the README's own text with its own heading levels, which
 * is what makes `split-readme.mjs`'s reassembly check meaningful. One
 * consequence needs correcting at render time rather than in the file: the
 * `overview` chunk begins with the README's title, `# resmon — Research
 * Monitor`, and the page already has an `h1` of its own. A leading `#` is
 * demoted to `##` so the page has one top-level heading. Only a heading on the
 * body's first line is touched, and only its level — the text is untouched, and
 * the Markdown on disk is untouched.
 */
const body = (entry.body ?? '').replace(/^(\s*)# (?=\S)/, '$1## ');
const { html, headings } = await renderMarkdown(body, { from: '.', fromReadme: true });
---

<Document
  title={entry.data.title}
  description={entry.data.summary}
  path={`/guide/${entry.id}/`}
  eyebrow="Guide"
  meta={entry.data.summary}
  html={html}
  headings={headings}
/>
