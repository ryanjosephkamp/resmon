---
/**
 * The guide index: every guide page, in its `order`, in the site's listing
 * form.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { url } from '../../lib/urls';

const guide = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Guide"
  description="Installing, running and configuring resmon: the long-form documentation, a page per topic."
  path="/guide/"
  width="wide"
>
  <header class="page-head">
    <h1>Guide</h1>
    <p class="lede">Installing, running, and configuring resmon, a page per topic.</p>
  </header>

  <IndexList
    rows={guide.map((entry) => ({
      href: url(`/guide/${entry.id}/`),
      title: entry.data.title,
      description: entry.data.summary,
    }))}
  />
</Base>

<style>
  .page-head {
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width-heavy) solid var(--color-rule-heavy);
  }

  h1 {
    margin-top: 0;
  }

  .lede {
    color: var(--color-text-muted);
    max-width: var(--measure);
    margin: 0;
  }
</style>
