---
/**
 * `docs/api-contract/README.md` at `/resmon/api-contract/`, the URL Jekyll
 * published it at.
 */
import { getEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';
import { renderMarkdown } from '../../lib/markdown';
import { readDocument } from '../../lib/documents';

const entry = await getEntry('apiContract', 'README');
if (!entry) throw new Error('docs/api-contract/README.md is missing');

const head = readDocument(entry.body ?? '', 'The API contract');
const { html, headings } = await renderMarkdown(head.body);
---

<Document
  title={head.title}
  description={head.description}
  path="/api-contract/"
  eyebrow="Contract"
  meta="docs/api-contract/README.md"
  html={html}
  headings={headings}
  width="wide"
/>
