---
/**
 * The list of update posts, shared by the home page and `/updates/`.
 *
 * The home page matters more than it looks: `BlogTab.tsx` loads
 * `https://ryanjosephkamp.github.io/resmon/` into its embedded reader before
 * the user has picked anything, so whatever this site puts at the root is the
 * first thing the app's Blog tab shows. Under Jekyll that was the post list.
 * Keeping the list on the home page keeps that first view useful.
 */
import type { CollectionEntry } from 'astro:content';
import { postPath, writtenDate, xmlSchemaUtc } from '../lib/posts';
import { url } from '../lib/urls';

interface Props {
  posts: CollectionEntry<'posts'>[];
  /** Kept for callers; the post's headline is now always the title. */
  withSummary?: boolean;
}

const { posts } = Astro.props;

/** The post's own `# Heading`, which says what the update was about. */
function headline(body: string | undefined): string {
  const match = (body ?? '').match(/^\s*#\s+(.*\S)\s*$/m);
  return match ? match[1].replace(/[*_`]/g, '') : '';
}

/**
 * The list said each update three times: the date, "resmon Update 26 —
 * September 21, 2026", and "Update 26 — The run that finishes". It now says
 * the number once, in the gutter, and the post's own headline as the title.
 */
function parts(title: string, body: string | undefined): { number: string; text: string } {
  const number = title.match(/Update\s+(\d+)/i)?.[1] ?? '';
  const head = headline(body).replace(/^Update\s+\d+\s*[—–-]\s*/i, '');
  return { number: number ? `Update ${number}` : '', text: head || title };
}
---

<ol class="posts">
  {
    posts.map((post) => {
      const { number, text } = parts(post.data.title, post.body);
      return (
        <li>
          <a href={url(postPath(post.id, post.data.date))}>
            {/*
              `datetime` must be a valid HTML date string, and the front matter is not one:
              `2026-04-24 12:00:00 -0400` has a space for the separator and an offset with no
              colon, which no parser is obliged to read. The machine-readable value is the
              instant in ISO form; the text is the day the author wrote.
            */}
            <time datetime={xmlSchemaUtc(post.data.date)}>{writtenDate(post.data.date)}</time>
            <span class="post-number">{number}</span>
            <span class="post-title">{text}</span>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li {
    margin: 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .posts a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
  }

  .posts a:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width-heavy);
    text-underline-offset: var(--underline-offset);
  }

  .posts time,
  .post-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .post-title {
    grid-column: 1 / -1;
    font-weight: var(--weight-bold);
  }

  @media (min-width: 46rem) {
    .posts a {
      grid-template-columns: var(--date-column) var(--post-number) 1fr;
      align-items: baseline;
      column-gap: var(--space-5);
    }

    .post-title {
      grid-column: auto;
    }
  }
</style>
