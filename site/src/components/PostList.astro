---
/**
 * The list of update posts, shared by the home page and `/updates/`.
 *
 * The home page matters more than it looks: `BlogTab.tsx` loads
 * `https://ryanjosephkamp.github.io/resmon/` into its embedded reader before
 * the user has picked anything, so whatever this site puts at the root is the
 * first thing the app's Blog tab shows. Under Jekyll that was the post list.
 * Keeping the list on the home page keeps that first view useful.
 */
import type { CollectionEntry } from 'astro:content';
import { postPath, displayDate } from '../lib/posts';
import { url } from '../lib/urls';

interface Props {
  posts: CollectionEntry<'posts'>[];
  /** Show the first line of each post beneath its title. */
  withSummary?: boolean;
}

const { posts, withSummary = false } = Astro.props;

/** The post's own `# Heading`, which says what the update was about. */
function headline(body: string | undefined): string {
  const match = (body ?? '').match(/^\s*#\s+(.*\S)\s*$/m);
  return match ? match[1].replace(/[*_`]/g, '') : '';
}
---

<ol class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={url(postPath(post.id, post.data.date))}>
          <time datetime={post.data.date.toString()}>{displayDate(post.data.date)}</time>
          <span class="post-title">{post.data.title}</span>
          {withSummary && headline(post.body) && (
            <span class="post-summary">{headline(post.body)}</span>
          )}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li + li {
    margin-top: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .posts a {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
  }

  .posts a:hover .post-title {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .posts time {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .post-title {
    font-weight: var(--weight-semibold);
    color: var(--color-link);
  }

  .post-summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 46rem) {
    .posts a {
      grid-template-columns: 11rem 1fr;
      align-items: baseline;
      column-gap: var(--space-5);
    }

    .posts time {
      grid-row: span 2;
    }

    .post-summary {
      grid-column: 2;
    }
  }
</style>
