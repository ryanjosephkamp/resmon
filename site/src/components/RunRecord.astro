---
/**
 * The Source wall from a real session, drawn as the app draws it: one row per
 * source, one column per run, one mark per cell.
 *
 * The data is `../data/run-record.json`, exported from the app's own
 * `GET /api/coverage/source-wall` and not edited; its `provenance` field says
 * where it came from and is printed under the grid. Marks are told apart by
 * shape, so the grid reads the same in either color scheme and to a reader who
 * does not see color. Each cell also carries its state in words for a screen
 * reader.
 *
 * The one motion on the page lives here: as the grid scrolls into view, each
 * column of marks fills in after the one before it, the way the runs happened.
 * It is CSS scroll-driven animation, so it needs no script; where that is not
 * supported, or motion is reduced, the grid is simply drawn.
 */
import record from '../data/run-record.json';

const runs = record.runs;
const utc = (iso: string) => `${iso.slice(11, 16)} UTC`;
const footnotes: { n: number; text: string }[] = [];
const rows = record.sources.map((source) => ({
  name: source.name,
  cells: source.cells.map((cell) => {
    let note: number | null = null;
    if (['failed', 'could_not_be_asked', 'not_recorded'].includes(cell.state) && cell.note) {
      note = footnotes.length + 1;
      footnotes.push({ n: note, text: cell.note });
    }
    return { ...cell, note };
  }),
}));
const recordedOn = new Date(`${record.recorded_on}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<figure class="record">
  <blockquote class="verdict">
    <p>“{record.verdict.headline}”</p>
    {record.verdict.detail.map((line) => <p class="verdict-detail">{line}</p>)}
  </blockquote>

  <div class="grid-wrap">
    <table class="grid">
      <caption class="visually-hidden">
        What each of {rows.length} sources did on each of {runs.length} runs, recorded {recordedOn}
      </caption>
      <thead>
        <tr>
          <th scope="col" class="source-head">Source</th>
          {runs.map((run) => (
            <th scope="col" class="run-head mono">
              <span class="visually-hidden">Run </span>{run.id}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="source">{row.name}</th>
            {row.cells.map((cell, col) => (
              <td class="cell" style={`--col: ${col}`}>
                <span class:list={['state', `state-${cell.state}`]} aria-hidden="true" />
                <span class="visually-hidden">{cell.label}</span>
                {cell.state === 'answered' && typeof cell.count === 'number' && (
                  <span class="count mono">{cell.count}</span>
                )}
                {cell.note && <sup class="mono">{cell.note}</sup>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>

    <ol class="runs">
      {runs.map((run) => (
        <li>
          <span class="mono run-n">{run.id}</span>
          <span>
            <strong>{run.label}</strong>, “{run.query}”, {run.sources} {run.sources === 1 ? 'source' : 'sources'}
            <span class="mono run-facts">{utc(run.started_at)} · {run.returned} returned · {run.new} new</span>
          </span>
        </li>
      ))}
    </ol>
  </div>

  <ul class="legend">
    {record.legend.map((entry) => (
      <li>
        <span class:list={['state', `state-${entry.state}`]} aria-hidden="true" />
        <span><strong>{entry.label}</strong> {entry.meaning}</span>
      </li>
    ))}
  </ul>

  <figcaption>
    {footnotes.map((f) => (
      <p class="footnote"><span class="mono">{f.n}</span> {f.text}</p>
    ))}
    <p class="provenance">{record.provenance}</p>
  </figcaption>
</figure>

<style>
  .record {
    margin: 0;
  }

  .verdict {
    margin: 0 0 var(--space-6);
    padding-block: var(--space-3);
    padding-inline: 0;
    border-block: var(--border-width) solid var(--color-rule-heavy);
    /* Only the two ink rules: the base blockquote's side rule would close it into a box. */
    border-inline-start: 0;
    color: var(--color-text);
    max-width: var(--measure-wide);
  }

  .verdict p {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .verdict .verdict-detail {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-text-muted);
  }

  .grid-wrap {
    display: grid;
    gap: var(--space-5);
  }

  .grid {
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .grid th,
  .grid td {
    padding: 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .source-head,
  .run-head {
    padding-bottom: var(--space-2) !important;
    border-bottom: var(--border-width-heavy) solid var(--color-rule-heavy) !important;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-align: start;
  }

  .run-head {
    width: var(--mark-cell);
    text-align: center;
  }

  .source {
    padding-inline-end: var(--space-5) !important;
    font-weight: var(--weight-bold);
    text-align: start;
    white-space: nowrap;
    height: var(--mark-cell);
  }

  .cell {
    position: relative;
    width: var(--mark-cell);
    text-align: center;
    vertical-align: middle;
  }

  .count {
    display: block;
    font-size: var(--text-2xs);
    line-height: 1;
    color: var(--color-text-faint);
    margin-top: var(--space-1);
  }

  sup {
    position: absolute;
    top: var(--space-1);
    inset-inline-end: var(--space-1);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
  }

  /* ---- The marks ------------------------------------------------------- */

  .state {
    display: inline-block;
    width: var(--mark-size);
    height: var(--mark-size);
    vertical-align: middle;
  }

  .state-answered {
    border-radius: 50%;
    background: var(--color-mark-ink);
  }

  .state-answered_empty {
    border-radius: 50%;
    border: var(--mark-stroke) solid var(--color-mark-ink);
  }

  .state-could_not_be_asked {
    border: var(--border-width) solid var(--color-mark-ink);
    background: var(--mark-hatch);
  }

  .state-failed {
    background: var(--mark-cross);
  }

  .state-not_recorded {
    width: calc(var(--mark-size) / 3);
    height: calc(var(--mark-size) / 3);
    border-radius: 50%;
    background: var(--color-mark-ink);
  }

  .state-not_selected {
    height: var(--border-width-heavy);
    background: var(--color-mark-quiet);
  }

  /* ---- Run key, legend, notes ------------------------------------------ */

  .runs {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .runs li {
    display: grid;
    grid-template-columns: var(--space-6) 1fr;
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .runs li + li {
    margin-top: 0;
  }

  .run-n {
    font-weight: var(--weight-semibold);
  }

  .run-facts {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .legend {
    list-style: none;
    margin: var(--space-6) 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .legend li {
    display: grid;
    grid-template-columns: var(--space-5) 1fr;
    align-items: baseline;
    margin: 0;
  }

  .legend strong {
    color: var(--color-text);
  }

  .footnote,
  .provenance {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  @media (min-width: 52rem) {
    .grid-wrap {
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: var(--space-7);
    }

    .legend {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- The fill -------------------------------------------------------- */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cell .state {
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--col) * 9%) entry calc(var(--col) * 9% + 40%);
      }
    }
  }

  @keyframes fill {
    from {
      opacity: 0.12;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
