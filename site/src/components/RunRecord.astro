---
/**
 * The Source wall from a real collection, drawn as the app draws it: one row
 * per source, one column per run, one mark per cell.
 *
 * The data is `../data/run-record.json`: the engine's own
 * `GET /api/coverage/source-wall`, and each run's record, exported unedited
 * by `resmon_scripts/frontend/demos/export_site.py`. Its `provenance` field
 * says where it came from and is printed under the grid. Marks are told apart
 * by shape, so the grid reads the same in either color scheme and to a reader
 * who does not see color. Each cell also carries its state in words for a
 * screen reader.
 */
import record from '../data/run-record.json';

const KIND: Record<string, string> = { deep_dive: 'Deep Dive', deep_sweep: 'Deep Sweep', automated_sweep: 'Watch' };
const TIME = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric', minute: '2-digit', timeZoneName: 'short', timeZone: 'America/New_York',
});
const DAY = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/New_York' });
const NUMBER = new Intl.NumberFormat('en-US');

const wall = record.wall;
const byId = new Map(record.runs.map((run) => [run.id, run]));
const runs = wall.runs.map((run) => {
  const own = byId.get(run.execution_id);
  // The wall's label is the kind and, for a watch, its name after a dash.
  const name = run.label.split(' — ')[1] ?? null;
  const sources = own?.repositories?.length ?? 0;
  return {
    id: run.execution_id,
    kind: KIND[run.execution_type] ?? 'Run',
    name,
    query: own?.query ?? null,
    sources,
    at: TIME.format(new Date(run.started_at)),
    returned: own?.result_count ?? null,
    added: own?.new_result_count ?? null,
  };
});
const footnotes: { n: number; text: string }[] = [];
const rows = wall.sources.map((source) => ({
  name: source.name,
  cells: source.cells.map((cell) => {
    let note: number | null = null;
    if (['failed', 'could_not_be_asked', 'not_recorded'].includes(cell.state) && cell.note) {
      note = footnotes.length + 1;
      footnotes.push({ n: note, text: cell.note });
    }
    return { ...cell, note };
  }),
}));
const recordedOn = DAY.format(new Date(wall.runs[0]?.started_at ?? Date.UTC(2026, 10, 3)));
---


<figure class="record">
  <blockquote class="verdict">
    <p>“{wall.verdict.headline}”</p>
    {wall.verdict.detail.map((line) => <p class="verdict-detail">{line}</p>)}
  </blockquote>

  <div class="grid-wrap">
    <table class="grid">
      <caption class="visually-hidden">
        What each of {rows.length} sources did on each of {runs.length} runs, recorded {recordedOn}
      </caption>
      <thead>
        <tr>
          <th scope="col" class="source-head">Source</th>
          {runs.map((run) => (
            <th scope="col" class="run-head">
              <span class="visually-hidden">Run </span>{run.id}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="source">{row.name}</th>
            {row.cells.map((cell) => (
              <td class="cell">
                <span class:list={['state', `state-${cell.state}`]} aria-hidden="true" />
                <span class="visually-hidden">{cell.label}</span>
                {cell.state === 'answered' && typeof cell.result_count === 'number' && (
                  <span class="count">{NUMBER.format(cell.result_count)}</span>
                )}
                {cell.note && <sup>{cell.note}</sup>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>

    <ol class="runs">
      {runs.map((run) => (
        <li>
          <span class="run-n">{run.id}</span>
          <span>
            <strong>{run.kind}</strong>{run.name ? <>, <span class="name">{run.name}</span></> : run.query && <>, “{run.query}”</>}{`, ${run.sources} ${run.sources === 1 ? 'source' : 'sources'}`}
            <span class="run-facts">
              {run.at}
              {run.returned !== null && ` · ${NUMBER.format(run.returned)} returned`}
              {run.added !== null && ` · ${NUMBER.format(run.added)} new`}
            </span>
          </span>
        </li>
      ))}
    </ol>
  </div>

  <ul class="legend">
    {wall.state_legend.map((entry) => (
      <li>
        <span class:list={['state', `state-${entry.state}`]} aria-hidden="true" />
        <span><strong>{entry.label}</strong> {entry.meaning}</span>
      </li>
    ))}
  </ul>

  <figcaption>
    {footnotes.map((f) => (
      <p class="footnote"><span class="footnote-n">{f.n}</span> {f.text}</p>
    ))}
    <p class="provenance">{record.provenance}</p>
  </figcaption>
</figure>

<style>
  .record {
    margin: 0;
  }

  .verdict {
    margin: 0 0 var(--space-6);
    padding-block: var(--space-3);
    padding-inline: 0;
    border-block: var(--border-width) solid var(--color-rule-heavy);
    /* Only the two ink rules: the base blockquote's side rule would close it into a box. */
    border-inline-start: 0;
    color: var(--color-text);
    max-width: var(--measure-wide);
  }

  .verdict p {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .verdict .verdict-detail {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-text-muted);
  }

  .grid-wrap {
    display: grid;
    gap: var(--space-5);
  }

  .grid {
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .grid th,
  .grid td {
    padding: 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .source-head,
  .run-head {
    padding-bottom: var(--space-2) !important;
    border-bottom: var(--border-width-heavy) solid var(--color-rule-heavy) !important;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-align: start;
  }

  .run-head {
    width: var(--mark-cell);
    text-align: center;
  }

  .source {
    padding-inline-end: var(--space-5) !important;
    font-weight: var(--weight-bold);
    text-align: start;
    white-space: nowrap;
    height: var(--mark-cell);
  }

  .cell {
    position: relative;
    width: var(--mark-cell);
    text-align: center;
    vertical-align: middle;
  }

  .count {
    display: block;
    font-size: var(--text-2xs);
    line-height: 1;
    color: var(--color-text-faint);
    margin-top: var(--space-1);
  }

  sup {
    position: absolute;
    top: var(--space-1);
    inset-inline-end: var(--space-1);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
  }

  /* ---- The marks ------------------------------------------------------- */

  .state {
    display: inline-block;
    width: var(--mark-size);
    height: var(--mark-size);
    vertical-align: middle;
  }

  .state-answered {
    border-radius: 50%;
    background: var(--color-mark-ink);
  }

  .state-answered_empty {
    border-radius: 50%;
    border: var(--mark-stroke) solid var(--color-mark-ink);
  }

  .state-could_not_be_asked {
    border: var(--border-width) solid var(--color-mark-ink);
    background: var(--mark-hatch);
  }

  .state-failed {
    background: var(--mark-cross);
  }

  .state-not_recorded {
    width: calc(var(--mark-size) / 3);
    height: calc(var(--mark-size) / 3);
    border-radius: 50%;
    background: var(--color-mark-ink);
  }

  .state-not_selected {
    height: var(--border-width-heavy);
    background: var(--color-mark-quiet);
  }

  /* ---- Run key, legend, notes ------------------------------------------ */

  .runs {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .runs li {
    display: grid;
    grid-template-columns: var(--space-6) 1fr;
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .runs li + li {
    margin-top: 0;
  }

  .run-n,
  .run-head,
  .count,
  sup,
  .footnote-n {
    font-variant-numeric: tabular-nums;
  }

  .run-n {
    font-weight: var(--weight-semibold);
  }

  .name {
    font-family: var(--font-serif);
    font-style: italic;
  }

  .state-answered_in_part {
    border-radius: 50%;
    background: linear-gradient(90deg, var(--color-mark-ink) 50%, transparent 50%);
    border: var(--mark-stroke) solid var(--color-mark-ink);
  }

  .run-facts {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .legend {
    list-style: none;
    margin: var(--space-6) 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .legend li {
    display: grid;
    grid-template-columns: var(--space-5) 1fr;
    align-items: baseline;
    margin: 0;
  }

  .legend strong {
    color: var(--color-text);
  }

  .footnote,
  .provenance {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  @media (min-width: 52rem) {
    .grid-wrap {
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: var(--space-7);
    }

    .legend {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
