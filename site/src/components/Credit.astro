---

<div class="credit">
  <p class="made">Made by <a href={AUTHOR}>Ryan Kamp</a></p>
  <ul class="social" aria-label="Ryan Kamp online">
    {
      socials.map((s) => (
        <li>
          <a href={s.href} aria-label={s.label} title={s.title}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <Fragment set:html={s.body} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
  <a class="sponsor" href={SPONSOR}>
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M10 16.8S3 12.6 3 7.6A3.6 3.6 0 0 1 10 6a3.6 3.6 0 0 1 7 1.6c0 5-7 9.2-7 9.2Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"></path>
    </svg>
    Sponsor on GitHub
  </a>
</div>

<style>
  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .made {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /*
   * Pulled left by the padding around each drawing, so the first icon lines up
   * with the text above it on a phone, where the row wraps under "Made by",
   * and sits one ordinary gap from it on a wider screen.
   */
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    margin-left: calc((var(--icon-size) - var(--target-size)) / 2);
    padding: 0;
    list-style: none;
  }

  .social li + li {
    margin-top: 0;
  }

  .social a {
    display: grid;
    place-items: center;
    width: var(--target-size);
    height: var(--target-size);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .social a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .social svg {
    width: var(--icon-size);
    height: var(--icon-size);
  }

  /*
   * An outlined button rather than a filled one: the site keeps its one color
   * for Download, so the heart is drawn in ink like every other icon here.
   */
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-size);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .sponsor:hover {
    color: var(--color-text);
    border-color: var(--color-text);
    background: var(--color-surface);
  }

  .sponsor svg {
    width: var(--icon-size-small);
    height: var(--icon-size-small);
  }

  /* On a phone the button takes its own line from the left edge. */
  @media (min-width: 40rem) {
    .sponsor {
      margin-left: auto;
    }
  }
</style>
