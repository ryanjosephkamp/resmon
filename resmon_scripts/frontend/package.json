{
  "name": "resmon",
  "version": "1.8.5",
  "description": "resmon \u2014 Research Monitor desktop application",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "webpack --mode production",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev:renderer": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit --project e2e/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts e2e/smoke.spec.ts",
    "prepare:backend": "node scripts/prepare-backend.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "electron-updater": "^6.8.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "build": {
    "appId": "com.resmon.app",
    "productName": "resmon",
    "copyright": "Ryan Kamp",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/backend",
        "to": "backend"
      }
    ],
    "beforePack": "scripts/prepare-backend.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist"
    },
    "asar": true,
    "dmg": {
      "artifactName": "resmon-${version}-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "resmon-${version}-setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "resmon-${version}-${arch}.${ext}",
      "category": "Science",
      "maintainer": "Ryan Kamp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryanjosephkamp",
        "repo": "resmon"
      }
    ]
  }
}
