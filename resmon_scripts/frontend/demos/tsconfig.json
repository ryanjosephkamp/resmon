{
  "//": "Playwright transpiles without typechecking, so this is what looks at demos/. `npm run typecheck:demos` runs it.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "types": ["node"],
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts", "../e2e/background-window.ts", "../e2e/fixtures/*.ts"]
}
