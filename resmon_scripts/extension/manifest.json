{
  "manifest_version": 3,
  "name": "Save to resmon",
  "version": "1.0.0",
  "description": "Right-click a paper's page or a link to it, and resmon opens Look Up a Paper with it filled in. Nothing is sent anywhere else.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  }
}
