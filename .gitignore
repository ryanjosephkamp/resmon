# =============================================================================
# resmon — .gitignore
# =============================================================================
# Note: Image files are intentionally NOT excluded. The project contains a
# small number of figures/screenshots that should be committed to the repo.
# =============================================================================

# -----------------------------------------------------------------------------
# Python artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
sdist/
wheels/
*.manifest
*.spec

# Test / coverage artifacts
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# -----------------------------------------------------------------------------
# Node / Electron artifacts
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
.npm/
.parcel-cache/
.next/
.nuxt/
.cache/
.turbo/
out/

# Electron build outputs
release/
app/dist/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap
*.msi
*.pkg

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
*.log.*

# -----------------------------------------------------------------------------
# Credentials and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
client_secret*.json
token.json
token.pickle
*.secret

# -----------------------------------------------------------------------------
# IDE / editor files
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
*.swn
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# resmon project-specific
# -----------------------------------------------------------------------------
# Internal planning artifacts (not for public repository)
.ai/
.ai:/
.resmon_background/

# Runtime / generated output directories
resmon_printouts/
resmon_experiments/
# The running backend writes its chosen port here, at the repo root. It is
# per-run state, it differs between the dev build and the daemon, and a
# committed one would point a later session at a port nothing is listening on.
resmon.port

resmon_reports/logs/
resmon_reports/pdfs/
resmon_reports/markdowns/

# macOS application bundle build artifact
resmon.app/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Local configuration / state overrides
*.local.json
*.local.yaml
local_settings.py

# Jest
coverage/

# Packaging output. build-resources holds a staged copy of the backend plus a
# ~900 MB virtual environment, both generated by scripts/prepare-backend.js;
# release/ holds the built .app. Neither belongs in git.
resmon_scripts/frontend/build-resources/*
# The entitlements file is source, not build output — it must ship with the repo.
!resmon_scripts/frontend/build-resources/entitlements.mac.plist
resmon_scripts/frontend/release/

# -----------------------------------------------------------------------------
# End-to-end run output (phase 1.8.7)
# -----------------------------------------------------------------------------
# The UI spike committed 15 PNGs and phase 1.8.6 added three more, and every
# stacked branch since has conflicted on them: two branches that both run the
# suite both regenerate every file, so the merge is a binary conflict on
# evidence nobody reads from the tree. A committed screenshot is a merge
# conflict, not evidence.
#
# Where they go instead: `ui-smoke.yml` uploads them as a workflow artifact,
# and `npm run e2e:review` writes them outside the repository for a handback to
# embed. The note at the top of this file still holds for the figures that
# belong to the documentation — this exempts one generated directory, not
# images in general.
resmon_scripts/frontend/e2e/screenshots/
resmon_scripts/frontend/e2e/test-results/
